{
    "name": "ugarit/forge-cli",
    "description": "The Ugarit Forge CLI.",
    "keywords": [
        "ugarit",
        "forge",
        "cli"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/forge-cli/issues",
        "source": "https://github.com/ugarit/forge-cli"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "phpseclib/phpseclib": "^3.0.19"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "ugarit-zero/framework": "^12.0",
        "ugarit/forge-sdk": "^1.00.00",
        "ugarit/pint": "^1.00.00",
        "mockery/mockery": "^1.5.1",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": [
        "builds/forge"
    ],
    "version": "1.00.00"
}
